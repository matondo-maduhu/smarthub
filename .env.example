# Nakili faili hili kuwa ".env" kisha jaza thamani zako. Usiweke ".env" kwenye repo.

APP_NAME=Jamvi
# Maneno marefu ya siri (angalau herufi 32). Linda vikao vya watumiaji.
SECRET_KEY=badilisha-hii-iwe-maneno-marefu-ya-siri

# Vidakuzi salama (inahitaji https). Weka 0 ukijaribu kwenye http bila SSL.
COOKIE_SECURE=1
# 1 = app iko nyuma ya proxy ya hosting (Render, Railway, Nginx...)
TRUST_PROXY=1

# Neon (Postgres) - nakili "Connection string" kutoka dashboard ya Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Anwani ya umma ya bucket (r2.dev au domain yako), mfano: https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Hali ya coin: demo = coin bandia (hakuna pesa halisi)
COIN_MODE=demo
# Thamani ya coin 1 kwa shilingi, na kiwango cha chini cha kutoa (coin)
COIN_RATE_TZS=100
MIN_WITHDRAW=50
# Jamvi la mikeka
TIP_FEE_PCT=10
TIP_MAX_PRICE=1000
MAX_TIPS_PER_DAY=10
MIN_SETTLED_FOR_RANK=5
# Market
MARKET_FEE_PCT=5
MARKET_MAX_PRICE=1000000
MAX_PRODUCTS_PER_DAY=10
ORDER_AUTO_RELEASE_DAYS=7
# Ujumbe: idadi ya juu kwa dakika kwa kila mtumiaji
MESSAGES_PER_MINUTE=10
# Zawadi ya kujiunga (coin bandia, hali ya demo tu)
SIGNUP_BONUS=100

# Kuingia kwa Google (hiari). Kitufe kinaonekana tu ukijaza hizi mbili.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Hiari. Kwa kawaida si lazima; weka kama Google inalalamika kuhusu redirect URI
GOOGLE_REDIRECT_URI=

# Wasimamizi (hiari). Anayelingana na mojawapo anakuwa msimamizi akiingia.
# Tumia koma kutenganisha. Ondoa kwenye orodha haimwondolei cheo (tumia SQL).
ADMIN_USERNAMES=
ADMIN_EMAILS=
ADMIN_PHONES=
